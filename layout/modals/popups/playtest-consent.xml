<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>

	<scripts>
		<include src="file://{resources}/scripts/common/dev.ts" />
		<include src="file://{resources}/scripts/modals/popups/playtest-consent.ts" />
	</scripts>

	<PopupCustomLayout class="PopupPanel Hidden generic-popup generic-popup--large" popupbackground="blur">
		<Panel class="flow-down">
			<Label class="text-h3 mb-4 full-width text-align-left" text="#MainMenu_PlaytestCampaignConsent_Title" />
			<Label class="mb-2" text="#MainMenu_PlaytestCampaignConsent_Description" />
		</Panel>

		<Panel class="flow-right full-width mt-4" tabindex="auto" selectionpos="auto">
			<Button
				class="button button--red horizontal-align-right"
				onactivate=""
				tabindex="auto"
				selectionpos="auto"
			>
				<Label class="button__text" text="[HC] Accept" />
			</Button>
			<Button
				class="button horizontal-align-right"
				onactivate="UiToolkitAPI.CloseAllVisiblePopups()"
				tabindex="auto"
				selectionpos="auto"
			>
				<Label class="button__text" text="#MainMenu_PrereleaseNotice_Decline" />
			</Button>
		</Panel>
	</PopupCustomLayout>
</root>
