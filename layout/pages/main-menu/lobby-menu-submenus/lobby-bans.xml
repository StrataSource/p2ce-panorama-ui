<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	<scripts>
		<include src="file://{scripts}/common/dev.ts" />
		<include src="file://{scripts}/common/fancy-list.ts" />
		<include src="file://{resources}/scripts/pages/main-menu/lobby-menu-submenus/lobby-bans.ts" />
	</scripts>

	<snippets>
		<snippet name="BanEntry">
			<Panel class="lobby-bans">
				<AvatarImage id="PlayerAvatar" class="lobby-bans__avatar" steamid="local" />
				<Label class="text-h5 vertical-align-center" text="{s:username}" />
				<Panel class="lobby-bans__buttons">
					<TooltipPanel tooltip="[HC] View Steam Profile" style="tooltip-position: right;" class="mr-1">
						<Button id="SteamProfileBtn" class="button">
							<Image class="button__icon" texturewidth="64" textureheight="64" src="file://{images}/icons/steam.svg" />
						</Button>
					</TooltipPanel>
					<TooltipPanel tooltip="[HC] Unban Player" style="tooltip-position: right;">
						<Button id="UnbanBtn" class="button button--green">
							<Image class="button__icon" texturewidth="64" textureheight="64" src="file://{images}/icons/account-check.svg" />
						</Button>
					</TooltipPanel>
				</Panel>
			</Panel>
		</snippet>
	</snippets>

	<Panel class="lobby-menu__base-content__management-panel__section" onload="LobbyBans.onLoad();">
		<Panel class="flow-right mb-1">
			<Label class="text-h5" text="[HC] Lobby Bans" />
			<Panel class="fill-width" />
			<Button id="UnbanAllBtn" class="button button--green">
				<Image class="button__icon" texturewidth="64" textureheight="64" src="file://{images}/icons/account-check.svg" />
				<Label class="vertical-align-center mr-1" text="[HC] Unban All" />
			</Button>
		</Panel>
		<Panel id="LobbyBans" class="flow-down" style="overflow: squish scroll;" tabindex="auto" selectionpos="auto">
			<Panel id="NoBansEntry" class="lobby-bans hide">
				<Image id="EmptyEntryAvatar" class="lobby-bans__avatar" src="file://{images}/menu/missing-cover.png" />
				<Label class="text-h5 vertical-align-center" text="[HC] No banned players..." />
			</Panel>
		</Panel>
	</Panel>
</root>
