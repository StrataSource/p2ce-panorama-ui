<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	<scripts>
		<include src="file://{scripts}/pages/main-menu/lobby-menu.ts" />
		<include src="file://{resources}/scripts/pages/main-menu/lobby-menu-submenus/lobby-info.ts" />
	</scripts>

	<snippets>
	</snippets>

	<Panel class="lobby-menu__base-content__management-panel__section" onload="LobbyInfo.onLoad()">
		<Label class="text-h4 mb-2" text="[HC] Lobby Info" />

		<Label class="mb-1" text="[HC] Players: {i:curplayers}/{i:maxplayers}" />
		<Label class="" text="[HC] Required Players To Start: {i:curplayers}/{i:requiredplayers}" />

		<Button class="button mr-1" onactivate="$.DispatchEvent('MainMenuOpenNestedPage', 'Multiplayer', 'main-menu/play/multiplayer/content-selector-mp', undefined)">
			<Label class="button__text" text="[HC] Change Campaign" />
		</Button>
	</Panel>
</root>
