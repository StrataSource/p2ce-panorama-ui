<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	<scripts>
		<!-- <include src="file://{resources}/scripts/pages/main-menu/lobby-menu-submenus/lobby-info.ts" /> -->
	</scripts>

	<snippets>
	</snippets>

	<Panel class="lobby-menu__base-content__management-panel__section" onload="">
		<Label class="text-h4 mb-2" text="#Settings_General_Title" />
		<Panel class="flow-down overflow-vscroll full-width">
			<Panel class="flow-down">
				<Label class="text-h5 mb-1" text="[HC] Server Settings" />

				<TextEntry id="TEHostName" class="textentry mt-1 mb-1" placeholder="Host Name" />
				<TextEntry id="TEServerTags" class="textentry mt-1 mb-1" placeholder="Server Tags" />
				<TextEntry id="TEPassword" class="textentry mt-1 mb-1" placeholder="Password" />
				<SettingsEnum
					text="[HC] Local Access Network (LAN | sv_lan)"
					infomessage="[HC] Should the lobby only be accessible over the local network?"
					convar="sv_lan"
				>
					<RadioButton group="lan" text="Disabled" value="0" />
					<RadioButton group="lan" text="Enabled"  value="1" />
				</SettingsEnum>
				<SettingsEnum
					text="[HC] Server Cheats (sv_cheats)"
					infomessage="[HC] Should server cheats be enabled?"
					convar="sv_cheats"
				>
					<RadioButton group="servercheats" text="Disabled" value="0" />
					<RadioButton group="servercheats" text="Enabled"  value="1" />
				</SettingsEnum>
			</Panel>

			<Panel class="horizontal-separator mt-2 mb-2" />

			<Panel class="flow-down">
				<Label class="text-h5" text="[HC] Lobby Settings" />
				<SettingsEnum
					text="[HC] Allow Client Invites"
					infomessage="[HC] Should joined client be allowed to invite other players?"
					convar="p2ce_lobby_allowclientinvites"
				>
					<RadioButton group="allowclientinvites" text="Disallowed" value="0" />
					<RadioButton group="allowclientinvites" text="Allowed"	  value="1" />
				</SettingsEnum>
				<SettingsEnum
					text="[HC] Lobby Visibility"
					infomessage="[HC] How should the lobby be visible on Steam and/or on the server browser?"
					convar="p2ce_lobby_visibility"
				>
					<RadioButton group="lobbyvisibility" text="Private" 	 value="0" />
					<RadioButton group="lobbyvisibility" text="Friends Only" value="1" />
					<RadioButton group="lobbyvisibility" text="Public" 		 value="2" />
				</SettingsEnum>
				<SettingsSlider
					text="Max Players"
					infomessage=""
					convar="maxplayers"
					tags=""
					min="1"
					max="33"
					snaptoincrement="true"
					increment="0."
					hasdocspage="false"
					changeoverride=""
				/>
				<ToggleButton id="TBAllowSpectators" class="checkbox">
					<Label text="Allow Spectators" />
				</ToggleButton>
			</Panel>
		</Panel>

	</Panel>
</root>
