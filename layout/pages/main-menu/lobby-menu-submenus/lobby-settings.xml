<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	<scripts>
		<!-- <include src="file://{resources}/scripts/pages/main-menu/lobby-menu-submenus/lobby-info.ts" /> -->
	</scripts>

	<snippets>
	</snippets>

	<Panel class="lobby-menu__base-content__management-panel__section" onload="">
		<Label class="text-h4 mb-2" text="#Settings_General_Title" />
		<Panel class="flow-down overflow-vscroll full-width pr-4">
			<Panel class="flow-down">
				<Label class="text-h5 mb-1" text="[HC] Server Settings" />

				<Panel class="flow-right">
					<Label class="horizontal-align-left vertical-align-center" text="[HC] Server Host Name" />
					<Panel class="fill-width" />
					<TextEntry id="TEServerHostName" class="textentry mt-1 mb-1" placeholder="[HC] Server Host Name" />
				</Panel>
				<Panel class="flow-right">
					<Label class="horizontal-align-left vertical-align-center" text="[HC] Server Tags" />
					<Panel class="fill-width" />
					<TextEntry id="TEServerTags" class="textentry mt-1 mb-1" placeholder="[HC] Server Tags" />
				</Panel>
				<Panel class="flow-right">
					<Label class="horizontal-align-left vertical-align-center" text="[HC] Password" />
					<Panel class="fill-width" />
					<TextEntry id="TEPassword" class="textentry mt-1 mb-1" placeholder="[HC] Password" />
				</Panel>
				<SettingsEnum
					text="[HC] Local Access Network (LAN)"
					infomessage="[HC] Should the lobby only be accessible over the local network?"
					convar="sv_lan"
				>
					<RadioButton group="lan" text="Off" value="0" />
					<RadioButton group="lan" text="On"  value="1" />
				</SettingsEnum>
				<SettingsEnum
					text="[HC] Server Cheats"
					infomessage="[HC] Should server cheats be enabled?"
					convar="sv_cheats"
				>
					<RadioButton group="servercheats" text="Off" value="0" />
					<RadioButton group="servercheats" text="On"  value="1" />
				</SettingsEnum>
			</Panel>

			<Panel class="horizontal-separator mt-2 mb-2" />

			<Panel class="flow-down">
				<Label class="text-h5" text="[HC] Lobby Settings" />
				<!-- <SettingsEnum
					text="[HC] Allow Client Invites"
