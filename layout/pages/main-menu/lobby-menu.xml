<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	<scripts>
		<include src="file://{scripts}/common/dev.ts" />
		<include src="file://{scripts}/pages/main-menu/lobby-menu.ts" />
	</scripts>

	<snippets>
		<snippet name="PlayerEntry">
			<Panel class="player-entry">
				<TooltipPanel tooltip="[HC] View Steam Profile">
					<Button id="SteamProfileBtn" class="">
						<AvatarImage id="PlayerAvatar" class="player-entry__avatar" steamid="local" />
					</Button>
				</TooltipPanel>

				<Panel class="player-entry__body ml-2">
					<Panel class="player-entry__body__player">
						<TooltipPanel tooltip="[HC] Host">
							<Image id="HostPlayerIcon" class="icon mr-1 hide" texturewidth="24" textureheight="24" src="file://{images}/crown-cropped.svg" />
						</TooltipPanel>
						<TooltipPanel tooltip="[HC] Steam Friend">
							<Image id="SteamFriendIcon" class="icon mr-1 hide" texturewidth="24" textureheight="24" src="file://{images}/profile-cropped.svg" />
						</TooltipPanel>

						<Label id="Name" text="{s:name}" class="text-h5 ml-1" />
						<!-- <Label id="Team" text="[HC] Team: {s:teamName}" class="text-h5 ml-1" /> -->
					</Panel>

					<TooltipPanel id="MissingAddons" class="player-entry__body__notice fancy-red hide" style="tooltip-position: bottom;" tooltip="[HC] This user is missing required addons needed to play the selected content.">
						<Label text="[HC] Missing Addons" />
					</TooltipPanel>
				</Panel>

				<Panel class="fill-width" />
				<TooltipPanel id="TeamIconTooltip" class="player-entry__body__team-icon" style="" tooltip="{s:teamName}">
					<Image id="TeamIcon" texturewidth="24" textureheight="24" class="" />
				</TooltipPanel>

				<Panel class="player-entry__body__buttons mr-1">
					<TooltipPanel tooltip="[HC] Kick Player" style="tooltip-position: right;">
						<Button id="KickBtn" class="button mb-1 hide">
							<Image class="button__icon" texturewidth="64" textureheight="64" src="file://{images}/cancel.svg" />
						</Button>
					</TooltipPanel>
					<TooltipPanel tooltip="[HC] Ban Player" style="tooltip-position: right;">
						<Button id="BanBtn" class="button button--red hide">
							<Image class="button__icon" texturewidth="64" textureheight="64" src="file://{images}/alert-octagon.svg" />
						</Button>
					</TooltipPanel>
				</Panel>
			</Panel>
		</snippet>

		<snippet name="EmptyEntry">
			<Panel class="player-entry">
				<Image id="EmptyEntryAvatar" class="player-entry__empty__icon" />
				<Label class="player-entry__empty__text text-h5" text="[HC] Waiting for player..." />
			</Panel>
		</snippet>
	</snippets>

	<Panel class="lobby-menu" hittest="false" onload="LobbyMenu.onLoad()">
		<Label
			id="LobbyHeadline"
			class="mainmenu__page-head"
			text="[HC] Lobby"
		/>
		<Label
			id="PageTagline"
			class="mainmenu__page-tagline"
			text="[HC] Play with your friends!"
		/>

		<Panel id="LobbyMenuBaseContent" class="lobby-menu__base-content">
			<Panel id="PlayerList" class="lobby-menu__base-content__player-list" />
			<Panel class="fill-width" />
			<Panel id="LobbyManPanel" class="lobby-menu__base-content__management-panel">
				<Label class="text-h4 m-4" text="[HC] Manage Lobby" />
				<Panel class="flow-right m-2 vertical-align-center horizontal-align-center">
					<RadioButton class="button radiobutton mr-2" selected="true" onactivate="LobbyManPanel.loadSubMenu('lobby-info')">
						<Label class="button__text" text="[HC] Lobby Info" />
					</RadioButton>
					<RadioButton class="button radiobutton mr-2">
						<Label class="button__text" text="[HC] Lobby Settings" onactivate="LobbyManPanel.loadSubMenu('lobby-settings')"/>
					</RadioButton>
					<RadioButton class="button radiobutton mr-2">
						<Label class="button__text" text="[HC] Ban List" onactivate="LobbyManPanel.loadSubMenu('ban-list')"/>
					</RadioButton>
				</Panel>
				<Panel id="LobbyManSubMenuInsert" class="lobby-menu__management-panel__section fill-width fill-height" />
				<Panel id="LobbyManPageBottom" class="fill-width flow-down m-2">
					<Panel class="flow-right m-2">
						<Button
							id="StartButton"
							class="button mr-2"
							onactivate="LobbyMenu.startGame();"
							onmouseover="LobbyMenu.startToolTipShow(true);"
							onmouseout="LobbyMenu.startToolTipShow(false);"
						>
							<Label class="button__text" text="[HC] Start Game" />
						</Button>
						<Button class="button mr-1" onactivate="P2CELobbyAPI.OpenInviteOverlay()">
							<Label class="button__text" text="[HC] Invite Players" />
						</Button>
					</Panel>
					<Panel class="flow-right mb-2">
						<Button class="button mr-1" onactivate="LobbyMenu.dumpSlotList()">
							<Label class="button__text" text="[DEV] Dump Player Entry List" />
						</Button>
						<Button class="button mr-1" onactivate="LobbyMenu.dumpBanList()">
							<Label class="button__text" text="[DEV] Dump Banned Player List" />
						</Button>
						<Button class="button mr-1" onactivate="$.DispatchEvent('MainMenuOpenNestedPage', 'ControlsLibrary', 'main-menu/dev/controls-library', undefined);">
							<Label class="button__text" text="#MainMenu_Navigation_ControlsLibrary" />
						</Button>
					</Panel>
				</Panel>
			</Panel>

			<Panel id="LobbyChat" class="">

			</Panel>
		</Panel>


		<Panel id="LobbyMenuBottom" class="vertical-align-bottom flow-down">
			<Panel class="flow-right">
				<Button class="button" onactivate="LobbyMenu.requestExit()">
					<Label class="button__text" text="[HC] Exit Lobby" />
				</Button>
				<Button id="ClientInviteButton" class="button ml-2 hide" onactivate="P2CELobbyAPI.OpenInviteOverlay()">
					<Label class="button__text" text="[HC] Invite Players" />
				</Button>
			</Panel>
		</Panel>
	</Panel>
</root>
