<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	<scripts>
		<include src="file://{scripts}/common/dev.ts" />
		<include src="file://{scripts}/pages/main-menu/lobby-menu.ts" />
	</scripts>

	<snippets>
		<snippet name="PlayerEntry">
			<Panel class="player-entry">
				<TooltipPanel tooltip="[HC] View Steam Profile">
					<Button id="SteamProfileBtn" class="">
						<AvatarImage id="PlayerAvatar" class="player-entry__avatar" steamid="local" />
					</Button>
				</TooltipPanel>

				<Panel class="player-entry__body ml-2">
					<Panel class="player-entry__body__player">
						<TooltipPanel tooltip="[HC] Host">
							<Image id="HostPlayerIcon" class="icon mr-1 hide" texturewidth="24" textureheight="24" src="file://{images}/crown-cropped.svg" />
						</TooltipPanel>
						<TooltipPanel tooltip="[HC] Steam Friend">
							<Image id="SteamFriendIcon" class="icon mr-1 hide" texturewidth="24" textureheight="24" src="file://{images}/profile-cropped.svg" />
						</TooltipPanel>
						<Label id="Name" text="{s:name}" class="text-h5 ml-1" />
						<Label id="Team" text="{s:teamName}" class="text-h5 ml-1" />
					</Panel>

					<TooltipPanel id="MissingAddons" class="player-entry__body__notice fancy-red hide" style="tooltip-position: right;" tooltip="[HC] This user is missing required addons needed to play the selected content.">
						<Label text="[HC] Missing Addons!" />
					</TooltipPanel>
				</Panel>

				<Panel class="player-entry__body__buttons">
					<TooltipPanel tooltip="[HC] Kick Player">
						<Button id="KickBtn" class="button mr-1">
							<Image class="button__icon" texturewidth="64" textureheight="64" src="file://{images}/cancel.svg" />
						</Button>
					</TooltipPanel>
					<TooltipPanel tooltip="[HC] Ban Player">
						<Button id="BanBtn" class="button mr-1 button--red">
							<Image class="button__icon" texturewidth="64" textureheight="64" src="file://{images}/alert-octagon.svg" />
						</Button>
					</TooltipPanel>
				</Panel>
			</Panel>
		</snippet>

		<!-- TODO: Implement these empty entries into the player list in TS when there are open slots -->
		<snippet name="EmptyEntry">
			<Panel class="player-entry" />
		</snippet>
	</snippets>

	<Panel class="lobby-menu" hittest="false" onload="LobbyMenu.onLoad()">
		<Label
			id="LobbyHeadline"
			class="mainmenu__page-head"
			text="[HC] Lobby"
		/>
		<Label
			id="PageTagline"
			class="mainmenu__page-tagline"
			text="[PH] Play with your friends!"
		/>

		<!-- <Panel id="LobbyMenuBase" class="flow-right"> -->
			<Panel id="PlayerList" class="lobby-menu__player-list" />

			<Panel id="LobbyManPanel" class="lobby-menu__management-panel">
				<Label class="text-h5 m-4" text="[PH] TEST" />
				<Panel class="flow-right m-2">
					<RadioButton class="button radiobutton mr-2">
						<Label class="button__text" text="[HC] Lobby Info" />
					</RadioButton>
					<RadioButton class="button radiobutton radiobutton mr-2">
						<Label class="button__text" text="[HC] Lobby Settings" />
					</RadioButton>
					<RadioButton class="button radiobutton radiobutton mr-2">
						<Label class="button__text" text="[HC] Blah" />
					</RadioButton>
				</Panel>
				<!-- <Label class="lobby-menu__management-panel__title" text="[PH] TEST" /> -->
			</Panel>

			<Panel id="LobbyChat" class="">

			</Panel>
		<!-- </Panel> -->


		<Panel id="LobbyMenuBottom" class="vertical-align-bottom flow-down m-3">
			<Label class="text-h5 mb-1" text="[STAFF ONLY] DEVELOPER CONTROLS" />
			<Panel class="flow-right mb-2">
				<Button class="button mr-1" onactivate="LobbyMenu.dumpPlayerEntries()">
					<Label class="button__text" text="Dump Player Entry List" />
				</Button>
				<Button class="button mr-1" onactivate="$.DispatchEvent('MainMenuOpenNestedPage', 'ControlsLibrary', 'main-menu/dev/controls-library', undefined);">
					<Label class="button__text" text="#MainMenu_Navigation_ControlsLibrary" />
				</Button>
				<Button class="button mr-1" onactivate="P2CELobbyAPI.OpenInviteOverlay()">
					<Label class="button__text" text="Invite" />
				</Button>
				<Button id="StartButton" class="button" onactivate="LobbyMenu.staffForceStart()">
					<Label class="button__text" text="Start" />
				</Button>
			</Panel>
			<Label class="text-h5 mb-1" text="[DEV] MISC. PUBLIC CONTROLS" />
			<Panel class="flow-right">
				<Button class="button" onactivate="LobbyMenu.requestExit()">
					<Label class="button__text" text="[HC] Exit Lobby" />
				</Button>
			</Panel>
		</Panel>
	</Panel>
</root>
