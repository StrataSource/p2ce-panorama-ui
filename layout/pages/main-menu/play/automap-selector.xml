<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	<scripts>
		<include src="file://{scripts}/common/dev.ts" />
		<include src="file://{scripts}/common/searcher.ts" />
		<include src="file://{scripts}/common/fancy-list.ts" />
		<include src="file://{scripts}/pages/main-menu/play/automap-selector.ts" />
	</scripts>

	<snippets>
		<snippet name="WorkshopNoneSnippet">
			<Panel class="workshop__none">
				<Panel class="horizontal-align-center vertical-align-center">
					<Label class="text-h5 mb-2" text="#MainMenu_Maps_None" />
					<Button
						onactivate="SteamOverlayAPI.OpenURL('https://steamcommunity.com/workshop/browse/?appid=440000&amp;browsesort=trend&amp;section=readytouseitems&amp;p=1&amp;num_per_page=30&amp;days=7&amp;requiredtags%5B%5D=Map')"
						class="button button-2x"
					>
						<Image
							class="button__icon button__icon--left my-1"
							texturewidth="64"
							textureheight="64"
							src="file://{images}/icons/steam.svg"
						/>
						<Label class="button__text button__text--right ml-1" text="#MainMenu_Campaigns_OpenWS" />
					</Button>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="Loader">
			<Panel class="addon-deps__entry__loader">
				<AnimatedImageStrip
					animating="true"
					defaultframe="0"
					frametime="125ms"
					src="file://{images}/menu/p2ce/spinner_strip.tga"
					scaling="stretch-to-cover-preserve-aspect"
				/>
				<Image
					class="addon-deps__entry__loader__logo"
					src="file://{images}/icons/steam.svg"
					textureheight="128"
					texturewidth="128"
					scaling="stretch-to-fit-preserve-aspect"
					hittest="false"
				/>
			</Panel>
		</snippet>
	</snippets>

	<Panel class="flow-down" onload="AutoMapSelector.init()">
		<Panel class="flow-right">
			<Panel class="flow-down">
				<Panel class="workshop__top-bar">
					<Button
						class="button mr-1"
						onactivate="SteamOverlayAPI.OpenURL('https://steamcommunity.com/workshop/browse/?appid=440000&amp;browsesort=trend&amp;section=readytouseitems&amp;p=1&amp;num_per_page=30&amp;days=7&amp;requiredtags%5B%5D=Map')"
						tabindex="auto"
						selectionpos="auto"
					>
						<Image
							class="button__icon"
							texturewidth="64"
							textureheight="64"
							src="file://{images}/icons/steam.svg"
						/>
					</Button>
					<TextEntry id="SearchBar" class="textentry workshop__search full-height mr-3" placeholder="#Common_SearchEllipsis" />
				</Panel>
				<Panel id="EntryInsert" class="fancy-list__entries fancy-list__entries__square mt-2" />
			</Panel>
			<Panel id="RightPane" class="horizontal-align-center vertical-align-bottom flow-down ml-2 hide">
				<Panel class="workshop__pane__cover">
					<Image id="SelectedCoverBg" class="workshop__pane__cover__blur" scaling="stretch-to-cover-preserve-aspect" />
					<Image id="SelectedCover" class="workshop__pane__cover__square-image" scaling="stretch-to-cover-preserve-aspect" />
				</Panel>
				<Panel class="workshop__pane">
					<Panel class="flow-down full-width px-3 mb-2">
						<Label id="SelectedTitle" class="workshop__pane__title" text="[PH] Title" />
						<Label id="SelectedAuthor" class="workshop__pane__author" text="[PH] Author" />
					</Panel>
					<Panel id="DependenciesWrapper" class="px-3 flow-down mb-2">
						<Label class="workshop__pane__divider mb-1" text="#UI_Dependencies" />
						<Panel id="Dependencies" class="flow-right overflow-hscroll full-width">
						</Panel>
					</Panel>
					<Panel class="flow-right px-3 flow-down">
						<Label class="workshop__pane__divider" text="#UI_Description" />
					</Panel>
					<Panel class="full-width fill-height mb-2">
						<Label id="SelectedDescription" class="workshop__pane__desc px-3" text="[PH] Description" html="true" />
					</Panel>
					<Panel class="full-width flow-right px-3">
						<Panel id="Steam" class="flow-right">
							<Button id="SelectedSteam" class="button mr-1">
								<Image
									class="button__icon"
									texturewidth="64"
									textureheight="64"
									src="file://{images}/icons/steam.svg"
								/>
							</Button>
							<RadioButton
								id="UpvoteBtn" group="detailsvote" class="vote--small upvote mr-1">
								<Image
									class="button__icon flip-vertical"
									texturewidth="64"
									textureheight="64"
									src="file://{images}/icons/thumb.svg"
								/>
							</RadioButton>
							<RadioButton id="DownvoteBtn" group="detailsvote" class="vote--small downvote mr-1">
								<Image
									class="button__icon"
									texturewidth="64"
									textureheight="64"
									src="file://{images}/icons/thumb.svg"
								/>
							</RadioButton>
						</Panel>
						<Button id="PlayBtn" class="button--nodisable button--green fill-width">
							<Image
								class="button__icon"
								scaling="stretch-to-fit-preserve-aspect"
								src="file://{images}/play.svg"
								texturewidth="64"
								textureheight="64"
							/>
							<Label id="SelectedActionLabel" class="button__text button__text--right" text="#MainMenu_Navigation_Play" />
						</Button>
					</Panel>
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
