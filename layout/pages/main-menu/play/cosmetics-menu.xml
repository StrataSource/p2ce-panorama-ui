				antialias="true"
				mouse_rotate="true"
			/>
			<!-- </Button> -->
		</Panel>

		<Panel id="BottomSection" class="cosmetics-menu__bottom-section">

			<Button class="button">
				<Label text="[HC] Change Skin" />
