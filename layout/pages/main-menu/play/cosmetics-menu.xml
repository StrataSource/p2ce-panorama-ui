<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	<scripts>
		<include src="file://{scripts}/common/dev.ts" />
		<include src="file://{scripts}/pages/main-menu/play/cosmetics-menu.ts" />
	</scripts>

	<Panel class="mainmenu__page flow-down" onload="CosmeticsMenu.onLoad()">
