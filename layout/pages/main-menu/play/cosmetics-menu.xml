				mouse_rotate="true"
			/>
			<!-- </Button> -->
			<!-- <Button class="cosmetics-menu__main-section__modelpanel"> -->
			<ModelPanel
				id="PlayerModel2"
				src="models/player/ballbot/ballbot.mdl"
