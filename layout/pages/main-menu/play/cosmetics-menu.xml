				mouse_rotate="true"
			/>
			<!-- </Button> -->
			<!-- <Button class="cosmetics-menu__main-section__modelpanel"> -->
			<ModelPanel
				id="PlayerModel3"
				src="models/player/eggbot/eggbot.mdl"
