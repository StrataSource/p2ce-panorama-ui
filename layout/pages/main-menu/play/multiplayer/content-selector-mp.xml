<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	<scripts>
		<include src="file://{scripts}/common/dev.ts" />
		<include src="file://{scripts}/pages/main-menu/play/multiplayer/content-selector-mp.ts" />
	</scripts>

	<Panel class="mainmenu__page" onload="ContentSelectorMP.onLoad()">
		<Panel id="Tabs" class="tabs mb-2">
			<Panel class="tabs__border tabs__border__right" />
			<RadioButton id="CampaignsBtn" class="tabs__item" group="tabs" onactivate="ContentSelectorMP.onTabSelected(0, true)">
				<Panel class="tabs__item__inner">
					<Label class="tabs__item-label" text="#MainMenu_Navigation_Campaign" />
				</Panel>
			</RadioButton>
			<Panel class="tabs__gap" />
			<RadioButton id="MapsBtn" class="tabs__item" group="tabs" onactivate="ContentSelectorMP.onTabSelected(1, true)">
				<Panel class="tabs__item__inner">
					<Label class="tabs__item-label" text="[HC] P2:CE Maps" />
				</Panel>
			</RadioButton>
			<Panel class="tabs__gap" />
			<RadioButton id="Portal2Btn" class="tabs__item" group="tabs" onactivate="ContentSelector.onTabSelected(2, true)">
				<Panel class="tabs__item__inner">
					<Label class="tabs__item-label" text="[HC] Portal 2 Maps" />
				</Panel>
			</RadioButton>
			<Panel class="tabs__border tabs__border__left" />
		</Panel>
		<Panel id="Insert" />
	</Panel>
</root>
