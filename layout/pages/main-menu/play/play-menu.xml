<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	<scripts>
		<include src="file://{scripts}/common/dev.ts" />
		<include src="file://{scripts}/pages/main-menu/play/play-menu.ts" />
	</scripts>

	<Panel class="mainmenu__page flow-right" onload="PlayMenu.setPlayerMenuLines()">
		<Button
			class="card play-menu__card mr-3"
			onactivate="PlayMenu.onSinglePlayerBtnPressed()"
			tabindex="auto"
			selectionpos="auto"
		>
			<Image
				class="card__image"
				src="file://{images}/menu/vertical-banner-solo.png"
				scaling="stretch-to-fit-preserve-aspect"
			/>
			<Panel class="card__details card__details__no-bg">
				<Label class="card__details__header" text="#MainMenu_Campaigns_CType_SP" />
			</Panel>
		</Button>
		<Button
			class="card play-menu__card"
			onactivate="PlayMenu.onMultiPlayerBtnPressed()"
			tabindex="auto"
			selectionpos="auto"
		>
			<Image class="card__image" src="file://{images}/menu/vertical-banner-mp.png" scaling="stretch-to-fit-preserve-aspect" />
			<Panel class="card__details card__details__no-bg">
				<Label class="card__details__header" text="#MainMenu_Campaigns_CType_MP" />
			</Panel>
		</Button>
		<Button
			class="card play-menu_card flow-right"
			onactivate="PlayMenu.onCosmeticBtnPressed()"
			tabindex="auto"
			selectionpos="auto"
		>
			<Panel class="play-menu__modelpanel">
				<ModelPanel
					id="PlayerModel1"
					src="models/player.mdl"
					sequence="nogun_standing_idle"
					antialias="true"
				/>
			</Panel>
			<Panel class="play-menu__modelpanel">
				<ModelPanel
					id="PlayerModel2"
					src="models/player/ballbot/ballbot.mdl"
					sequence="taunt_highFive_idle"
					antialias="true"
				/>
			</Panel>
			<Panel class="play-menu__modelpanel">
				<ModelPanel
					id="PlayerModel3"
					src="models/player/eggbot/eggbot.mdl"
					sequence="taunt_teamhug_idle"
					antialias="true"
				/>
			</Panel>
			<Panel class="card__details card__details__no-bg">
				<Label class="card__details__header" text="[HC] Cosmetic Menu" />
			</Panel>
		</Button>

	</Panel>
</root>
