<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	<scripts>
		<include src="file://{scripts}/common/dev.ts" />
		<include src="file://{scripts}/pages/main-menu/voting-p2.ts" />
	</scripts>

	<snippets>
		<snippet name="MenuBackgroundLayer">
			<Panel class="full">
				<!-- Backbuffer blur: used to blur the backbuffer in the pause menu -->
				<BaseBlurTarget
					id="PauseMenuMainMenuBlur"
					class="mainmenu__pause-blur"
					blurrects="PauseMenuMainMenuContent"
					hittest="false"
				>
					<!-- Backbuffer background -->
					<BackbufferImagePanel hittest="false" class="mainmenu__background" />
				</BaseBlurTarget>

				<Panel id="PauseMenuMainMenuContent" hittest="false" class="mainmenu__pause-content-blur" />
			</Panel>
		</snippet>
	</snippets>

	<Panel class="vertical-align-center full-width flow-down m-5" hittest="false" onload="VotingMenuPortal2.onLoad()">
		<Panel class="flow-down full-width">
			<Label id="MapTitle" class="map-voting__title" text="[PH] Map Title" />
			<Panel class="flow-right">
				<AvatarImage id="MapAuthorImg" class="map-voting__avatar" steamid="local" />
				<Label id="MapAuthorLabel" class="map-voting__author" text="[PH] Author" />
			</Panel>
			<Image id="MapCover" class="map-voting__cover" scaling="stretch-to-cover-preserve-aspect" />
			<Panel class="map-voting__voters">
				<RadioButton group="vote" id="MapUpvote" class="vote upvote mr-3" onactivate="VotingMenuPortal2.setMapVote(1)">
					<Image class="vote__icon flip-vertical" texturewidth="96" textureheight="96" src="file://{images}/icons/thumb.svg" />
				</RadioButton>
				<RadioButton group="vote" id="MapDownvote" class="vote downvote" onactivate="VotingMenuPortal2.setMapVote(0)">
					<Image class="vote__icon" texturewidth="96" textureheight="96" src="file://{images}/icons/thumb.svg" />
				</RadioButton>
			</Panel>
		</Panel>
		<Panel class="flow-right mt-2">
			<Button class="button button--red mr-1" onactivate="VotingMenuPortal2.onQuitPressed()">
				<Label class="button__text" text="[HC] Return to Menu" />
			</Button>
			<Button class="button mr-1" onactivate="VotingMenuPortal2.onRestartPressed()">
				<Label class="button__text" text="[HC] Restart" />
			</Button>
			<Button class="button button--p2-blue mr-1" onactivate="VotingMenuPortal2.onNextLevelPressed()">
				<Label class="button__text" text="[HC] Next Level" />
			</Button>
			<Button class="button" onactivate="VotingMenuPortal2.onChangeLevelPressed()">
				<Label class="button__text" text="[HC] View Queue" />
			</Button>
		</Panel>
	</Panel>
</root>
